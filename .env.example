# Gemini (LLM provider — see context.md "LLM provider" section; NOT Anthropic)
# One key, or several comma-separated keys (no spaces needed) — lib/gemini.js
# rotates to the next key when the current one gets rate-limited (HTTP 429):
# GEMINI_API_KEY=AIzaSy...key1,AIzaSy...key2,AIzaSy...key3
GEMINI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, provisioned but unused in app code — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
